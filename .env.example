# Copie este arquivo para ".env" (copy .env.example .env no Windows, cp .env.example .env no Linux/Mac)
# e troque a chave e a senha. O ".env" NÃO vai para o GitHub; este ".env.example" vai.
# ---- Django ----
# chave secreta do Django: gere uma com python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
# True liga o modo de desenvolvimento (mostra erros detalhados); em produção use False
DJANGO_DEBUG=True
# endereços pelos quais a API pode ser acessada, separados por vírgula
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# ---- PostgreSQL ----
# estes três nomes são os que a imagem oficial do PostgreSQL lê para criar o banco
POSTGRES_DB=financas
POSTGRES_USER=financas
POSTGRES_PASSWORD=troque-esta-senha
# db é o NOME DO SERVIÇO no docker-compose (rede interna do Docker), não "localhost"
POSTGRES_HOST=db
# 5432 é a porta padrão do PostgreSQL
POSTGRES_PORT=5432
